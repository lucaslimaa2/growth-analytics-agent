# Copy this file to .env and fill in the values.
# .env is gitignored; .env.example is committed so anyone forking the repo
# knows what variables are required.

# Supabase: direct connection (port 5432).
# Use for seed scripts and migrations.
SUPABASE_DB_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres

# Supabase: transaction pooler (port 6543).
# Use for serverless functions at runtime.
SUPABASE_DB_URL_POOLED=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-<N>-<REGION>.pooler.supabase.com:6543/postgres

# Anthropic API key (https://console.anthropic.com).
ANTHROPIC_API_KEY=sk-ant-...
